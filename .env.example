# App
APP_NAME=AI Customer Service Agent
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/chatbot.db

# AI Providers
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Admin Security
ADMIN_API_KEY=admin_secret_key_change_me
JWT_SECRET_KEY=change_me_super_secret_jwt_key_2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# CORS
ALLOWED_ORIGINS=*

# Facebook
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_token
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_VERIFY_TOKEN=your_custom_verify_token

# Instagram (uses same Meta tokens as Facebook)
INSTAGRAM_PAGE_ACCESS_TOKEN=your_instagram_page_token

# TikTok
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram (for staff escalation)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Escalation Messenger
ESCALATION_MESSENGER_PAGE_TOKEN=your_escalation_page_token
ESCALATION_MESSENGER_RECIPIENT_ID=your_staff_psid
